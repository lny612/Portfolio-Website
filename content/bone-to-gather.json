    "221dac73-098e-802c-aaa3-d896868b0fcb": {
      "id": "221dac73-098e-802c-aaa3-d896868b0fcb",
      "type": "text",
      "properties": {
        "title": [
          [
            "간단한 게임 소개:",
            [
              [
                "b"
              ]
            ]
          ],
          [
            " \nBone To Gather는 하찮지만 독특한 능력을 가진 스켈레톤들로 시너지에 맞는 팀을 구성해 전투하는 팀 빌딩 액션 로그라이크 게임입니다. 방해꾼 몬스터들을 처치하며 얻은 자금으로 다양한 스켈레톤들을 팀에 영입하고, 시너지를 조합해, 그들의 능력을 비웃은 마왕을 무찌르기 위한 복수의 여정을 떠나세요."
          ]
        ]
      }
    },
