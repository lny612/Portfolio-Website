      "properties": {
        "title": [
          [
            "MDA(메커닉–다이내믹–미학) 기반 플레이테스트를 통해 플레이어 피드백을 수집하고, 점수 개선을 위해 패치를 적용했습니다"
          ]
        ]
      },
      "format": {
